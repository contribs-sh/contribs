# Copy to .env and fill in. Only needed for sources whose entry sets a "tokenEnv".
# github.com accounts authenticated via the `gh` CLI do NOT need a token here
# (the fetch script pulls them with `gh auth token --user <username>`).

# Second github.com account (if not in the gh keyring): a PAT with repo + read:org
GH_SECOND_TOKEN=

# GitHub Enterprise PAT (repo + read:org on your enterprise host)
GHE_TOKEN=

# Codeberg / Forgejo access token (read:user scope)
CODEBERG_TOKEN=

# GitLab (gitlab.com or self-managed): PAT with read_api
GITLAB_TOKEN=

# Bitbucket Cloud: API token / app password with read:repository
BITBUCKET_TOKEN=

# Azure DevOps: PAT with Code (Read)
AZURE_DEVOPS_TOKEN=
