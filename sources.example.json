{
  "sources": [
    {
      "id": "gh-personal",
      "label": "GitHub (personal)",
      "type": "github",
      "host": "github.com",
      "username": "your-github-username",
      "enabled": true
    },
    {
      "id": "gh-second",
      "label": "GitHub (second account)",
      "type": "github",
      "host": "github.com",
      "username": "YOUR_OTHER_USERNAME",
      "tokenEnv": "GH_SECOND_TOKEN",
      "enabled": false
    },
    {
      "id": "ghe-work",
      "label": "GitHub Enterprise (work)",
      "type": "github",
      "host": "github.your-company.com",
      "username": "YOUR_ENTERPRISE_USERNAME",
      "tokenEnv": "GHE_TOKEN",
      "enabled": false
    },
    {
      "id": "codeberg-main",
      "label": "Codeberg (main)",
      "type": "forgejo",
      "host": "codeberg.org",
      "username": "YOUR_CODEBERG_USERNAME",
      "tokenEnv": "CODEBERG_TOKEN",
      "enabled": false
    },
    {
      "id": "gitlab-main",
      "label": "GitLab",
      "type": "gitlab",
      "host": "gitlab.com",
      "username": "YOUR_GITLAB_USERNAME",
      "tokenEnv": "GITLAB_TOKEN",
      "enabled": false
    },
    {
      "id": "bitbucket-old-job",
      "label": "Bitbucket (old job)",
      "type": "bitbucket",
      "username": "YOUR_BITBUCKET_USERNAME",
      "emails": [
        "you@old-employer.example"
      ],
      "tokenEnv": "BITBUCKET_TOKEN",
      "to": "2019-12-31",
      "enabled": false
    },
    {
      "id": "azure-work",
      "label": "Azure DevOps (work)",
      "type": "azure",
      "host": "dev.azure.com/YOUR_ORG",
      "emails": [
        "you@company.example"
      ],
      "tokenEnv": "AZURE_DEVOPS_TOKEN",
      "enabled": false
    },
    {
      "id": "local-history",
      "label": "Recovered (local git)",
      "type": "local",
      "paths": [
        "~/code/old-work"
      ],
      "emails": [
        "you@old-employer.example"
      ],
      "from": "2015-01-01",
      "to": "2019-12-31",
      "enabled": false
    }
  ]
}
